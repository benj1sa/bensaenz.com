// Cloudflare Worker that serves only static files (no server code).
{
  "name": "bensaenz-com",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./_site",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "bensaenz.com", "custom_domain": true },
    { "pattern": "www.bensaenz.com", "custom_domain": true }
  ]
}
